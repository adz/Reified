artifacts/*
!artifacts/.gitkeep

# The package-consumer fixtures do not use the repository artifacts layout: they restore and build in
# place, the way an outside consumer does, so their build output lands beside their sources.
tests/package-consumers/*/obj/
tests/package-consumers/*/bin/
.vs/
.idea/
.fake
*.swp
.codex
.fsdocs/
output/
tmp/
site/node_modules/
site/resources/
site/public/
site/output/
site/.hugo_build.lock
BenchmarkDotNet.Artifacts/
examples/Reified.ReferenceApp/.reified-reference-data/

# Generated documentation. Reference trees are produced by scripts/generate-api-docs.sh
# and site/content by scripts/populate-hugo-content.sh; CI regenerates both in
# scripts/build-docs-site.sh, so neither belongs in history.
docs/*/reference/
site/content/
