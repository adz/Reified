<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <!-- Every package in this repository ships on one release train. The Flow train moved out with
         Flow itself: a tag here says nothing about a version in the Axial repository. -->
    <ReifiedVersion>0.7.0</ReifiedVersion>

    <Version Condition="'$(Version)' == ''">$(ReifiedVersion)</Version>
    <NuGetAudit>false</NuGetAudit>
    <RepositoryUrl>https://github.com/adz/Reified</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/adz/Reified</PackageProjectUrl>
    <FsDocsCollectionName>Reified</FsDocsCollectionName>
    <FsDocsLogoLink>https://github.com/adz/Reified</FsDocsLogoLink>
    <FsDocsLogoSource>content/img/reified-inline-light.svg</FsDocsLogoSource>
    <FsDocsFaviconSource>content/img/favicon-light.svg</FsDocsFaviconSource>
    <FsDocsLicenseLink>https://github.com/adz/Reified/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/adz/Reified/blob/main/RELEASE_NOTES.md</FsDocsReleaseNotesLink>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
