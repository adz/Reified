<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <!-- NativeAOT reports summary warnings for FSharp.Core's own analysis; project source remains warning-fatal. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>

    <!-- Every package in this repository ships on one release train. The Flow train moved out with
         Flow itself: a tag here says nothing about a version in the Axial repository. -->
    <ReifiedVersion>0.6.0</ReifiedVersion>

    <Version Condition="'$(Version)' == ''">$(ReifiedVersion)</Version>
    <NuGetAudit>false</NuGetAudit>
    <RepositoryUrl>https://github.com/adz/Reified</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/adz/Reified</PackageProjectUrl>
    <FsDocsCollectionName>Reified</FsDocsCollectionName>
    <FsDocsLogoLink>https://github.com/adz/Reified</FsDocsLogoLink>
    <FsDocsLogoSource>content/img/reified-inline-light.svg</FsDocsLogoSource>
    <FsDocsFaviconSource>content/img/favicon-light.svg</FsDocsFaviconSource>
    <FsDocsLicenseLink>https://github.com/adz/Reified/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/adz/Reified/blob/main/RELEASE_NOTES.md</FsDocsReleaseNotesLink>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The .NET 10 SDK's implicit FSharp.Core reference floats to whatever FSharp.Core ships with
       it (10.1.x), and that becomes the floor NuGet records in every published package. A dotnet8
       consumer resolving an older FSharp.Core then hits NU1605 (downgrade). Pin explicitly to the
       oldest FSharp.Core that still supports net8.0/netstandard2.1, so the package floor stays low
       regardless of which SDK builds it. FSCorePackageVersion is read by
       Microsoft.FSharp.Core.NetSdk.props, guarded by FSCorePackageVersionSet, so both must be set
       here (before that file imports) for the override to take. -->
  <PropertyGroup>
    <FSCorePackageVersionSet>true</FSCorePackageVersionSet>
    <FSCorePackageVersion>8.0.100</FSCorePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
