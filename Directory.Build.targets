<Project>

  <!--
    Fable compiles a library from its F# sources, not its assembly, because an `inline` member has
    no body once compiled. A package that ships only lib/ builds fine under `dotnet build` and fails
    under `dotnet fable` with "Cannot find inline member", a failure that surfaces only in whichever
    downstream repository targets JavaScript, and only when someone actually runs Fable.

    Fable looks for a `fable/` folder in a package. Projects opt in with IsFableLibrary; how that
    folder is laid out is declared once, here.

    This lives in .targets rather than .props because .props is imported before the project body,
    where IsFableLibrary has not been set yet.

    The project file in fable/ is generated rather than copied. Inside a package there are no
    sibling checkouts, so this project's own ProjectReferences could not resolve; each is emitted as
    a PackageReference at the version being packed, which Fable satisfies from that package's own
    fable/ folder. Compile order is F#-significant, so it is taken from @(Compile) verbatim.
  -->

  <PropertyGroup Condition="'$(IsFableLibrary)' == 'true'">
    <FableProjectFile>$(BaseIntermediateOutputPath)fable\$(MSBuildProjectFile)</FableProjectFile>
    <!--
      Fable copies this alongside the compiled output in a consumer's fable_modules/. Every Reified
      Fable module is import/export/const/function/class declarations only, with no top-level
      statements, so a browser bundler can drop unreferenced ones outright: a manifest that never
      resolves a refined field then keeps nothing from Reified.Constraint or Reified.Refinements.
      The Fable target's hasTopLevelSideEffect scan keeps this claim honest.
    -->
    <FablePackageJsonFile>$(BaseIntermediateOutputPath)fable\package.json</FablePackageJsonFile>
  </PropertyGroup>

  <Target Name="WriteFableProjectFile"
          Condition="'$(IsFableLibrary)' == 'true'"
          BeforeTargets="GenerateNuspec;_GetPackageFiles">

    <ItemGroup>
      <_FableLine Include="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;" />
      <_FableLine Include="  &lt;PropertyGroup&gt;" />
      <_FableLine Include="    &lt;TargetFramework&gt;netstandard2.1&lt;/TargetFramework&gt;" />
      <_FableLine Include="    &lt;DisableImplicitFSharpCoreReference&gt;true&lt;/DisableImplicitFSharpCoreReference&gt;" />
      <_FableLine Include="  &lt;/PropertyGroup&gt;" />
      <_FableLine Include="  &lt;ItemGroup&gt;" />
      <!-- Sibling Reified projects become package dependencies at this same version. -->
      <_FableLine Include="    &lt;PackageReference Include=&quot;%(ProjectReference.Filename)&quot; Version=&quot;$(Version)&quot; /&gt;"
                  Condition="'%(ProjectReference.Filename)' != ''" />
      <!-- Real package dependencies carry across as they are, minus build-only ones. -->
      <_FableLine Include="    &lt;PackageReference Include=&quot;%(PackageReference.Identity)&quot; Version=&quot;%(PackageReference.Version)&quot; /&gt;"
                  Condition="'%(PackageReference.PrivateAssets)' != 'All' and '%(PackageReference.PrivateAssets)' != 'all'" />
      <_FableLine Include="  &lt;/ItemGroup&gt;" />
      <_FableLine Include="  &lt;ItemGroup&gt;" />
      <_FableLine Include="    &lt;Compile Include=&quot;%(Compile.Identity)&quot; /&gt;" />
      <_FableLine Include="  &lt;/ItemGroup&gt;" />
      <_FableLine Include="&lt;/Project&gt;" />
    </ItemGroup>

    <MakeDir Directories="$(BaseIntermediateOutputPath)fable" />
    <WriteLinesToFile File="$(FableProjectFile)" Lines="@(_FableLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(FablePackageJsonFile)"
                      Lines="{ &quot;type&quot;: &quot;module&quot;, &quot;sideEffects&quot;: false }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup Condition="'$(IsFableLibrary)' == 'true'">
    <None Include="$(FableProjectFile)" Pack="true" PackagePath="fable\$(MSBuildProjectFile)" Visible="false" />
    <None Include="$(FablePackageJsonFile)" Pack="true" PackagePath="fable\package.json" Visible="false" />
    <None Include="**\*.fs;**\*.fsi"
          Exclude="$(BaseIntermediateOutputPath)**;$(BaseOutputPath)**;bin\**;obj\**;artifacts\**"
          Pack="true"
          PackagePath="fable\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <!--
    Package maturity is declared once per packable project as <PackageMaturity> and derived into the
    package metadata at pack time: the level is appended to PackageTags as maturity-<level> and prefixed
    to PackageDescription (the NuGet description) as [Level]. The check runs only when the project is
    packable and declares a PackageId, so tests, tools, and examples never fail it; a packable project
    without a valid value fails the pack.
  -->
  <Target Name="ApplyPackageMaturity"
          Condition="'$(IsPackable)' != 'false' and '$(PackageId)' != ''"
          BeforeTargets="GenerateNuspec">

    <Error Condition="'$(PackageMaturity)' == ''"
           Text="$(PackageId) is packable but declares no &lt;PackageMaturity&gt;. Set it to Experimental, Incubating, or Stable." />

    <Error Condition="'$(PackageMaturity)' != '' and '$(PackageMaturity)' != 'Experimental' and '$(PackageMaturity)' != 'Incubating' and '$(PackageMaturity)' != 'Stable'"
           Text="$(PackageId) declares an invalid &lt;PackageMaturity&gt; value '$(PackageMaturity)'. Valid values are Experimental, Incubating, and Stable." />

    <PropertyGroup Condition="'$(PackageMaturity)' == 'Experimental' or '$(PackageMaturity)' == 'Incubating' or '$(PackageMaturity)' == 'Stable'">
      <_ReifiedMaturityTag>maturity-$(PackageMaturity.ToLowerInvariant())</_ReifiedMaturityTag>
      <PackageTags Condition="'$(PackageTags)' == ''">$(_ReifiedMaturityTag)</PackageTags>
      <PackageTags Condition="'$(PackageTags)' != ''">$(PackageTags);$(_ReifiedMaturityTag)</PackageTags>
      <PackageDescription>[$(PackageMaturity)] $(PackageDescription)</PackageDescription>
    </PropertyGroup>
  </Target>

</Project>
