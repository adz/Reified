<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiled twice: by the solution for .NET, and by `dotnet fable` for JavaScript
       (scripts/check-fable-js-surface.sh). netstandard2.1 is what the Fable-supported packages target. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reified.Constraint\Reified.Constraint.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Data\Reified.Data.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Schema\Reified.Schema.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Schema.Json\Reified.Schema.Json.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Checks.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
