<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Dogfood checked-in generation. Package consumers only need the Contracts.Build reference;
         the source-tree task path and import below stand in for that package during repository builds. -->
    <ReifiedSchemaGeneratedFiles>CheckedIn</ReifiedSchemaGeneratedFiles>
    <ReifiedSchemaGenToolPath>$(ArtifactsPath)/bin/schemagen/$([System.String]::Copy('$(Configuration)').ToLowerInvariant())/schemagen.dll</ReifiedSchemaGenToolPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="wire/workspace.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reified.Schema\Reified.Schema.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Schema.Json\Reified.Schema.Json.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Data\Reified.Data.fsproj" />
  </ItemGroup>

  <Target Name="BuildSourceTreeSchemagen" BeforeTargets="ReifiedSchemaGen">
    <MSBuild
      Projects="..\..\scripts\schemagen\schemagen.fsproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Import Project="..\..\src\Reified.Schema.Contracts.Build\build\Reified.Schema.Contracts.Build.targets" />

</Project>
