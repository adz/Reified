<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <!-- Without this, the probe's own records get a generated sprintf "%+A" ToString, which roots FSharp.Core printf. -->
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.fs" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Reified.Result\Reified.Result.fsproj"
                      AdditionalProperties="TargetFramework=net8.0" />
  </ItemGroup>
</Project>
