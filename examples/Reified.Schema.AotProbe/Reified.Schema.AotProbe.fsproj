<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <UsingTask TaskName="ComputeManagedAssemblies"
             Override="true"
             AssemblyFile="$(ILLinkTasksAssembly)"
             Condition="'$(PublishAot)' == 'true' and '$(ILLinkTasksAssembly)' != ''" />

  <UsingTask TaskName="ILLink"
             Override="true"
             AssemblyFile="$(ILLinkTasksAssembly)"
             Condition="'$(PublishAot)' == 'true' and '$(ILLinkTasksAssembly)' != ''" />

  <!-- A project reference does not import package build assets, so import the props a package consumer receives. -->
  <Import Project="..\..\src\Reified.Schema\buildTransitive\Reified.Schema.props" />

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reified.Schema\Reified.Schema.fsproj"
                      AdditionalProperties="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
