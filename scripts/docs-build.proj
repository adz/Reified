<Project>
  <PropertyGroup>
    <DocsBuildScope Condition="'$(DocsBuildScope)' == ''">All</DocsBuildScope>
  </PropertyGroup>

  <ItemGroup Condition="'$(DocsBuildScope)' == 'All' Or '$(DocsBuildScope)' == 'Api'">
    <DocsProject Include="../src/Axial.Result/Axial.Result.fsproj" />
    <DocsProject Include="../src/Axial.Data/Axial.Data.fsproj" />
    <DocsProject Include="../src/Axial.Constraint/Axial.Constraint.fsproj" />
    <DocsProject Include="../src/Axial.Refined/Axial.Refined.fsproj" />
    <DocsProject Include="../src/Axial.Parse/Axial.Parse.fsproj" />
    <DocsProject Include="../src/Axial.Schema/Axial.Schema.fsproj" />
    <DocsProject Include="../src/Axial.Schema.Json/Axial.Schema.Json.fsproj" />
    <DocsProject Include="../src/Axial.Schema.Http/Axial.Schema.Http.fsproj" />
    <DocsProject Include="../src/Axial.Schema.Contracts/Axial.Schema.Contracts.fsproj" />
    <DocsProject Include="../src/Axial.Schema.Testing/Axial.Schema.Testing.fsproj" />
    <DocsProject Include="docgen/docgen.fsproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DocsBuildScope)' == 'All' Or '$(DocsBuildScope)' == 'Examples'">
    <DocsProject Include="../examples/Axial.Schema.Examples/Axial.Schema.Examples.fsproj" />
  </ItemGroup>

  <Target Name="Build">
    <MSBuild
      Projects="@(DocsProject)"
      Targets="Build"
      BuildInParallel="true"
      Properties="UseSharedCompilation=true" />
  </Target>
</Project>
