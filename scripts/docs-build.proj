<Project>
  <PropertyGroup>
    <DocsBuildScope Condition="'$(DocsBuildScope)' == ''">All</DocsBuildScope>
  </PropertyGroup>

  <ItemGroup Condition="'$(DocsBuildScope)' == 'All' Or '$(DocsBuildScope)' == 'Api'">
    <DocsProject Include="../src/Reified.Result/Reified.Result.fsproj" />
    <DocsProject Include="../src/Reified.Data/Reified.Data.fsproj" />
    <DocsProject Include="../src/Reified.Constraint/Reified.Constraint.fsproj" />
    <DocsProject Include="../src/Reified.Refinements/Reified.Refinements.fsproj" />
    <DocsProject Include="../src/Reified.Parse/Reified.Parse.fsproj" />
    <DocsProject Include="../src/Reified.Schema/Reified.Schema.fsproj" />
    <DocsProject Include="../src/Reified.Schema.Json/Reified.Schema.Json.fsproj" />
    <DocsProject Include="../src/Reified.Schema.Http/Reified.Schema.Http.fsproj" />
    <DocsProject Include="../src/Reified.Schema.Contracts/Reified.Schema.Contracts.fsproj" />
    <DocsProject Include="../src/Reified.Schema.Testing/Reified.Schema.Testing.fsproj" />
    <DocsProject Include="docgen/docgen.fsproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DocsBuildScope)' == 'All' Or '$(DocsBuildScope)' == 'Examples'">
    <DocsProject Include="../examples/Reified.Schema.Examples/Reified.Schema.Examples.fsproj" />
  </ItemGroup>

  <Target Name="Restore">
    <MSBuild
      Projects="@(DocsProject)"
      Targets="Restore"
      BuildInParallel="true" />
  </Target>

  <Target Name="Build" DependsOnTargets="Restore">
    <MSBuild
      Projects="@(DocsProject)"
      Targets="Build"
      BuildInParallel="true"
      Properties="UseSharedCompilation=true" />
  </Target>
</Project>
