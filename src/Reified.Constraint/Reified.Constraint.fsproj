<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <PackageId>Reified.Constraint</PackageId>
    <AssemblyName>Reified.Constraint</AssemblyName>
    <RootNamespace>Reified.Constraint</RootNamespace>
    <Authors>Adam Davies</Authors>
    <Description>Reusable, inspectable value constraints for F#: one declaration for runtime checking, refined values, schema, and export.</Description>
    <PackageProjectUrl>https://github.com/adz/Reified</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Reified</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;validation;constraints;schema;result;error-handling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <FsDocsCollectionName>Reified</FsDocsCollectionName>
    <FsDocsLogoSource>content/img/reified-inline-light.svg</FsDocsLogoSource>
    <FsDocsLogoAlt>Reified.Constraint</FsDocsLogoAlt>
    <FsDocsLogoLink>https://github.com/adz/Reified</FsDocsLogoLink>
    <FsDocsLicenseLink>https://github.com/adz/Reified/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/adz/Reified/blob/main/RELEASE_NOTES.md</FsDocsReleaseNotesLink>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Platform.fs" />
    <Compile Include="ConstraintValue.fs" />
    <Compile Include="MessageKey.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="Catalogue.fs" />
    <Compile Include="ConstraintAtom.fs" />
    <Compile Include="Violation.fs" />
    <Compile Include="ConstraintDescription.fs" />
    <Compile Include="Predicates.fs" />
    <Compile Include="Constraint.fs" />
    <Compile Include="ConstraintDSL.fs" />
  </ItemGroup>

</Project>
