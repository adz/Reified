<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <PackageId>Reified.Data</PackageId>
    <AssemblyName>Reified.Data</AssemblyName>
    <RootNamespace>Reified</RootNamespace>
    <Authors>Adam Davies</Authors>
    <Description>Portable structured data values and concise F# construction syntax.</Description>
    <PackageProjectUrl>https://github.com/adz/Reified</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Reified</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;data;structured-data;json;aot;fable</PackageTags>
    <PackageReadmeFile>Reified.Data.README.md</PackageReadmeFile>
    <FsDocsCollectionName>Reified</FsDocsCollectionName>
    <FsDocsLogoSource>content/img/reified-inline-light.svg</FsDocsLogoSource>
    <FsDocsLogoAlt>Reified.Data</FsDocsLogoAlt>
    <FsDocsLogoLink>https://github.com/adz/Reified</FsDocsLogoLink>
    <FsDocsLicenseLink>https://github.com/adz/Reified/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/adz/Reified/blob/main/RELEASE_NOTES.md</FsDocsReleaseNotesLink>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="Reified.Data.README.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Data.fs" />
    <Compile Include="DataPath.fs" />
    <Compile Include="DataConversions.fs" />
    <Compile Include="DataLookup.fs" />
    <Compile Include="DataErgonomicsTypes.fs" />
    <Compile Include="DataInternals.fs" />
    <Compile Include="DataRendering.fs" />
    <Compile Include="DataPatching.fs" />
    <Compile Include="DataComparison.fs" />
    <Compile Include="DataMatching.fs" />
    <Compile Include="DataErgonomics.fs" />
  </ItemGroup>

</Project>
