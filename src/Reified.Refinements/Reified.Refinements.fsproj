<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
    <PackageId>Reified.Refinements</PackageId>
    <!-- Ships F# sources under fable/ so Fable can compile this; see Directory.Build.props. -->
    <IsFableLibrary>true</IsFableLibrary>
    <AssemblyName>Reified.Refinements</AssemblyName>
    <RootNamespace>Reified.Refinements</RootNamespace>
    <Authors>Adam Davies</Authors>
    <Description>Constraint-backed invariant-carrying domain values for F#.</Description>
    <PackageProjectUrl>https://github.com/adz/Reified</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Reified</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;refined-types;refinement-types;domain-types;value-objects;smart-constructors</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <ProjectReference Include="..\Reified.Constraint\Reified.Constraint.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Refinement.fs" />
    <Compile Include="NonEmpty.fs" />
    <Compile Include="Interval.fs" />
    <Compile Include="Bounded.fs" />
    <Compile Include="Finite.fs" />
    <Compile Include="UnitInterval.fs" />
    <Compile Include="Refine.fs" />
  </ItemGroup>
</Project>
