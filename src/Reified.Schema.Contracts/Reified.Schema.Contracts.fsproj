<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <IsPackable>false</IsPackable>

    <!-- Not packed (IsPackable=false), so the repo-wide FSharp.Core floor in Directory.Build.props
         doesn't need to apply here. This project references FSharp.Compiler.Service, which itself
         requires FSharp.Core >= 10.1.204 - overriding back up avoids a spurious NU1605 downgrade. -->
    <FSCorePackageVersion>10.1.204</FSCorePackageVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Reified.Schema.Contracts</AssemblyName>
    <RootNamespace>Reified.Schema.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Records.fs" />
    <Compile Include="Resolver.fs" />
    <Compile Include="Emitter.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.204" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reified.Data\Reified.Data.fsproj" />
  </ItemGroup>

</Project>
