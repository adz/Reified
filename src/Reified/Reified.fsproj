<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Umbrella package. It carries no assembly and no API of its own: installing Reified installs the
    focused runtime packages, and every type still comes from the package that owns it. Adding a
    Compile item here would create a second place a name could come from, which is exactly what the
    umbrella exists to avoid.

    That rule survived the namespace flatten, but the reasoning behind it moved. `Reified` is now the
    namespace the focused packages declare, not a name this project owns, so `open Reified` reaches
    Schema, Constraint, Data, and Parse without anything being re-exported. F# cannot re-export a
    module in any case: no abbreviation, no AutoOpen, no alias. A facade here would therefore have to
    restate every public function by hand, which is the duplication the rule was written to prevent.

    Reified.Schema.Contracts.Build is deliberately absent. MSBuild `build/` assets do not flow through
    a transitive package reference, so an umbrella dependency would install the targets without ever
    running them. Projects that derive schemas at build time reference that package directly.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>Reified</PackageId>
    <Authors>Adam Davies</Authors>
    <Description>Declare value and model invariants once, then derive validation, parsing, diagnostics, codecs, and contracts from the same declaration. This umbrella package installs every Reified runtime package; install a focused package instead when you need only one capability.</Description>
    <PackageProjectUrl>https://github.com/adz/Reified</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/adz/Reified</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>fsharp;reified;schema;validation;constraint;parsing;json</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reified.Constraint\Reified.Constraint.fsproj" />
    <ProjectReference Include="..\Reified.Refinements\Reified.Refinements.fsproj" />
    <ProjectReference Include="..\Reified.Parse\Reified.Parse.fsproj" />
    <ProjectReference Include="..\Reified.Result\Reified.Result.fsproj" />
    <ProjectReference Include="..\Reified.Data\Reified.Data.fsproj" />
    <ProjectReference Include="..\Reified.Schema\Reified.Schema.fsproj" />
    <ProjectReference Include="..\Reified.Schema.Json\Reified.Schema.Json.fsproj" />
  </ItemGroup>

  <!-- Reified.Schema.Http is .NET-only, so netstandard2.1 consumers (Fable, older hosts) get the
       rest of the umbrella rather than no umbrella at all. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\Reified.Schema.Http\Reified.Schema.Http.fsproj" />
  </ItemGroup>

</Project>
