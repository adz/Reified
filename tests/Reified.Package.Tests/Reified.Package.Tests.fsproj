<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads project files rather than referencing them: the subject is the package graph, and a
       ProjectReference to the umbrella would prove nothing about what NuGet ships. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);FS0988</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PackageGraphTests.fs" />
    <Compile Include="RuntimeAssemblyTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reified.Constraint\Reified.Constraint.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Data\Reified.Data.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Parse\Reified.Parse.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Refinements\Reified.Refinements.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Result\Reified.Result.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Schema\Reified.Schema.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Schema.Http\Reified.Schema.Http.fsproj" />
    <ProjectReference Include="..\..\src\Reified.Schema.Testing\Reified.Schema.Testing.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Unquote" Version="7.0.0" />
  </ItemGroup>

</Project>
