<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear so a consumer fixture can never silently restore an older Reified from nuget.org -->
    <clear />
    <add key="reified-local" value="../../artifacts/package" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
